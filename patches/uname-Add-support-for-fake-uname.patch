From 01c6660582811fc34bd83eaa8e16f06504175b5a Mon Sep 17 00:00:00 2001
From: Chizuui <desckun@gmail.com>
Date: Mon, 12 Oct 2026 19:52:52 +0700
Subject: [PATCH] sys: integrate spoof uname for BPF
 (bpfloader/netbpfload/netd)


diff --git a/kernel/sys.c b/kernel/sys.c
index f8d52c9042fe..ad3da2c0bde8 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1229,6 +1229,31 @@ static int override_release(char __user *release, size_t len)
 {
 	int ret = 0;
 
+	if (current_uid().val == 0) {
+		if (strncmp(current->comm, "bpfloader", 9) == 0 ||
+		    strncmp(current->comm, "netbpfload", 10) == 0 ||
+		    strncmp(current->comm, "netd", 4) == 0) {
+			char fake[65];
+			const char *real_suffix = UTS_RELEASE;
+			size_t flen;
+
+			while (*real_suffix && *real_suffix != '-') {
+				real_suffix++;
+			}
+
+			snprintf(fake, sizeof(fake), "5.10.239%s", real_suffix);
+			flen = strlen(fake) + 1;
+
+			if (len < flen)
+				return -EINVAL;
+
+			if (copy_to_user(release, fake, flen))
+				return -EFAULT;
+
+			return 0;
+		}
+	}
+
 	if (current->personality & UNAME26) {
 		const char *rest = UTS_RELEASE;
 		char buf[65] = { 0 };
-- 
