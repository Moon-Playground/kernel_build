diff --git a/repack_apk.py b/repack_apk.py
index 32876ed..d8482ca 100644
--- a/repack_apk.py
+++ b/repack_apk.py
@@ -221,7 +221,7 @@ def collect_existing_ksud_arches(apk_path: Path) -> List[str]:
     seen = set()
     with ZipFile(apk_path, "r") as zin:
         for name in zin.namelist():
-            if not (name.startswith("lib/") and name.endswith("/libksud.so")):
+            if not (name.startswith("lib/") and (name.endswith("/libksud.so") or name.endswith("/libmsud.so"))):
                 continue
             parts = name.split("/")
             if len(parts) >= 3 and parts[1] and parts[1] not in seen:
@@ -261,8 +261,8 @@ def repack_apk(
                     if len(parts) >= 3 and parts[1] not in arch_filters:
                         continue
 
-                # Drop original libksud.so only for arches that have a replacement binary.
-                if name.startswith("lib/") and name.endswith("/libksud.so"):
+                # Drop original libksud.so and libmsud.so for arches that have a replacement binary.
+                if name.startswith("lib/") and (name.endswith("/libksud.so") or name.endswith("/libmsud.so")):
                     parts = name.split("/")
